{
    "name": "New Tab",
    "version": "0.1.0",
    "manifest_version": 3,
    "description": "New Tab",
    "permissions": [
        "storage",
        "unlimitedStorage",
        "declarativeNetRequest"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "local_requests",
                "enabled": true,
                "path": "local-request-rules.json"
            }
        ]
    },
    "host_permissions": [
        "https://www.google.com/complete/search",
        "https://www.baidu.com/sugrec"
    ],
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.bilibili.com/*",
                "https://t.bilibili.com/*",
                "https://live.bilibili.com/*",
                "https://space.bilibili.com/*",
                "https://player.bilibili.com/*"
            ],
            "js": [
                "bilibili_indexeddb.js",
                "bilibili_cdn.js",
                "bilibili_sentry.js",
                "bilibili.js"
            ],
            "all_frames": true,
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://*.*.*/*"
            ],
            "js": [
                "jumpserver.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
